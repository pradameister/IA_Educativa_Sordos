# Backend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=localhost

# Database Configuration (PostgreSQL/MongoDB - próximamente)
# DATABASE_URL=mongodb://localhost:27017/ia-educativa
# DATABASE_URL=postgresql://user:password@localhost:5432/ia-educativa

# OpenAI / Claude API
# OPENAI_API_KEY=sk-...
# CLAUDE_API_KEY=sk-...

# JWT Secret for Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
